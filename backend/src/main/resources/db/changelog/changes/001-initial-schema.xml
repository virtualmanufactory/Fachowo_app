<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-initial-schema" author="fachowo">
        <createTable tableName="users">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="email" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password_hash" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="categories">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="slug" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="voivodeships">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="slug" type="varchar(100)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="cities">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="voivodeship_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_cities_voivodeship" references="voivodeships(id)"/>
            </column>
            <column name="slug" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="varchar(150)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="cities" columnNames="voivodeship_id, slug" constraintName="uk_cities_voivodeship_slug"/>

        <createTable tableName="companies">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="owner_id" type="uuid">
                <constraints nullable="false" unique="true" foreignKeyName="fk_companies_owner" references="users(id)"/>
            </column>
            <column name="category_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_companies_category" references="categories(id)"/>
            </column>
            <column name="city_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_companies_city" references="cities(id)"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="slug" type="varchar(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="nip" type="varchar(10)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="description" type="text"/>
            <column name="address" type="varchar(500)"/>
            <column name="latitude" type="decimal(10,7)"/>
            <column name="longitude" type="decimal(10,7)"/>
            <column name="serves_customers_at_home" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="varchar(20)"/>
            <column name="email" type="varchar(255)"/>
            <column name="website" type="varchar(500)"/>
            <column name="verified" type="boolean" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="available" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="companies" indexName="idx_companies_category_city">
            <column name="category_id"/>
            <column name="city_id"/>
        </createIndex>

        <createTable tableName="services">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_services_company" references="companies(id)"/>
            </column>
            <column name="name" type="varchar(255)">
                <constraints nullable="false"/>
            </column>
            <column name="price" type="decimal(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="unit" type="varchar(50)">
                <constraints nullable="false"/>
            </column>
            <column name="available" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="services" indexName="idx_services_company">
            <column name="company_id"/>
        </createIndex>

        <createTable tableName="company_images">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_company_images_company" references="companies(id)"/>
            </column>
            <column name="object_key" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="varchar(100)"/>
            <column name="created_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="company_verifications">
            <column name="id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="company_id" type="uuid">
                <constraints nullable="false" foreignKeyName="fk_verifications_company" references="companies(id)"/>
            </column>
            <column name="nip" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="source" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="varchar(20)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="text"/>
            <column name="verified_at" type="timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>
</databaseChangeLog>
